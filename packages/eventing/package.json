{
  "name": "@kiro-ai-bit/eventing",
  "version": "0.1.0",
  "description": "Medo event transport: per-service outbox, broker_db.events, sequential consumers, dead letters",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiro-ai-bit/medo-shared.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "pg": "8.16.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@kiro-ai-bit/tsconfig": "0.1.0",
    "@types/node": "26.6.7",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
