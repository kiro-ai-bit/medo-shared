{
  "name": "@kiro-ai-bit/rate-limit",
  "version": "0.1.0",
  "description": "Medo shared Fastify rate-limit plugin: in-memory sliding window, public/write/read scopes, internal-route bypass",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiro-ai-bit/medo-shared.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "fastify-plugin": "6.0.1"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@kiro-ai-bit/tsconfig": "0.1.0",
    "@types/node": "26.6.7",
    "fastify": "5.12.8",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
